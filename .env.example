# Copy to .env and fill in. Never commit .env. Empty = code default (see agent/config.py).

# --- LLM (vLLM, OpenAI-compatible) ---
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=
LLM_READY_TIMEOUT=
LLM_ENABLE_THINKING=
LLM_TEMPERATURE=
LLM_MAX_TOKENS=
# Optional hosted fallback while the GPU warms up (off when empty)
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=

# --- Web search: fake | searxng | brave | off ---
SEARCH_PROVIDER=
SEARCH_URL=
SEARCH_API_KEY=
# Comma-separated domains; empty disables web tools
SEARCH_ALLOW_LIST=
SEARXNG_SECRET=

# --- Catalog store: memory | pg ---
STORE=
DATABASE_URL=
POSTGRES_PASSWORD=
EMBEDDING_MODEL=
CATALOG_PATH=

# --- Booking ---
CALENDAR_PROVIDER=
APPOINTMENT_TYPES=
BUSINESS_HOURS=
SLOT_MINUTES=
BOOKING_LEAD_HOURS=
TIMEZONE=
PRIVACY_NOTICE_URL=

# --- Roles ---
INTERNAL_TOKENS=

# --- Agent loop, logging, API ---
AGENT_MAX_STEPS=
AGENT_MAX_WEB_CALLS=
TOOL_TIMEOUT=
STREAM_ANSWER=
LOG_CHAT_CONTENT=
HANDOFF_WEBHOOK_URL=
CORS_ORIGINS=
SESSION_TTL_MINUTES=
# Sessions + rate limits shared by all agent-api replicas (empty = in memory, one replica only)
REDIS_URL=
RATE_CHAT_PER_MIN_IP=
RATE_CHAT_PER_MIN_SESSION=
RATE_BOOK_PER_HOUR_SESSION=
