# Model A: Qwen3-14B, 4-bit AWQ (~9 GB weights). Fits a 16 GB GPU with a short context; 16k on 24 GB (L4).
MODEL=Qwen/Qwen3-14B-AWQ
QUANT_FLAGS="--quantization awq_marlin"
# 16 GB dev GPU: 6144 / 0.75. On an L4 (24 GB): MAX_MODEL_LEN=16384 GPU_MEM_UTIL=0.90
MAX_MODEL_LEN=${MAX_MODEL_LEN:-6144}
GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.75}
TOOL_PARSER=hermes
