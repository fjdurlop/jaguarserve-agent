# Model B: Qwen3-30B-A3B-Instruct-2507, 4-bit (~17 GB weights, ~3B active params per token).
# Needs a 24 GB GPU (L4 / A10G). Set MODEL to a 4-bit AWQ or GPTQ build you have verified
# (licence, checksum, tool calling with the hermes parser) before use.
MODEL=${MODEL_B:-}
QUANT_FLAGS=""
MAX_MODEL_LEN=${MAX_MODEL_LEN:-16384}
GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.92}
TOOL_PARSER=hermes
